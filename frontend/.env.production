# --- Weekly Geos -----------------------------------------------------
#
# A production build has no dev server, so the /weekly-api proxy does not
# exist: either the site is served behind something that forwards that
# prefix to the reporting API, or this is set to an absolute URL and that
# service sends CORS headers for this origin.
VITE_WEEKLY_API_BASE_URL=http://10.27.27.140:5156/api

VITE_WEEKLY_USE_MOCK=false
